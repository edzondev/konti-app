---
import { ArrowRight, ChevronDown } from "lucide-react";
import { FAQ_ITEMS } from "../lib/faq";
import { CONTACT_EMAIL } from "../lib/links";
---

<section class="faq-section wrap" id="preguntas">
	<div class="faq-intro">
		<div class="eyebrow">SIN LETRA CHICA</div>
		<h2>Por si te lo<br /><em>estabas preguntando.</em></h2>
		<p>
			Y si te queda alguna duda,<br /><a href={`mailto:${CONTACT_EMAIL}`}>escríbenos <ArrowRight size={14} /></a>
		</p>
	</div>
	<div class="faq-list">
		{
			FAQ_ITEMS.map((item, index) => (
				<div class="faq-item">
					<h3>
						<button
							type="button"
							aria-expanded={index === 1 ? "true" : "false"}
							aria-controls={`faq-answer-${index}`}
							id={`faq-question-${index}`}
						>
							{item.q}
							<ChevronDown size={19} className={index === 1 ? "rotated" : undefined} />
						</button>
					</h3>
					<section
						id={`faq-answer-${index}`}
						aria-labelledby={`faq-question-${index}`}
						hidden={index === 1 ? undefined : true}
					>
						<p>{item.a}</p>
					</section>
				</div>
			))
		}
	</div>
</section>
