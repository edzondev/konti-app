---
import { ArrowRight } from "lucide-react";
import { CONTACT_EMAIL, routes } from "../lib/links";
import Wordmark from "./Wordmark.astro";
---

<footer class="site-footer wrap">
	<div class="footer-top">
		<div>
			<a href="#inicio" aria-label="Konti, inicio"><Wordmark /></a>
			<p>Tu mini contador personal.<br />Sin complicarte la vida.</p>
		</div>
		<div class="footer-links">
			<a href={routes.privacidad}>Privacidad</a>
			<a href={routes.terminos}>Términos</a>
			<a href={`mailto:${CONTACT_EMAIL}`}>
				{CONTACT_EMAIL} <ArrowRight size={13} style={{ transform: "rotate(-45deg)" }} />
			</a>
		</div>
	</div>
	<div class="footer-bottom">
		<span>© 2026 Konti</span>
		<span>Hecho en Perú. Con los pies en la tierra.</span>
		<a href="#inicio">Volver arriba ↑</a>
	</div>
</footer>
