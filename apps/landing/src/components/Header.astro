---
import { ArrowRight, Menu, X } from "lucide-react";
import Wordmark from "./Wordmark.astro";
---

<header class="site-header wrap" id="inicio">
	<a href="#inicio" aria-label="Konti, inicio"><Wordmark /></a>
	<nav aria-label="Navegación principal">
		<a href="#como-funciona">Cómo funciona</a>
		<a href="#por-que-konti">Por qué Konti</a>
		<a href="#preguntas">Preguntas</a>
	</nav>
	<a href="#descargar" class="header-cta">
		<span class="small-dot"></span> Pronto en Android <ArrowRight size={15} />
	</a>
	<button class="menu-toggle" type="button" aria-expanded="false" aria-label="Abrir menú">
		<Menu size={22} className="menu-icon-open" />
		<X size={22} className="menu-icon-close" />
	</button>
</header>
