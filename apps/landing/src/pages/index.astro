---
import Faq from "../components/Faq.astro";
import Features from "../components/Features.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import PersonalNote from "../components/PersonalNote.astro";
import Story from "../components/Story.astro";
import Voice from "../components/Voice.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Konti — Toma una foto. Entiende tu mes."
	description="Toma una foto. Entiende tu mes. Konti organiza tus boletas y te dice qué significan, sin saber de contabilidad. Tu mini contador personal en Perú."
	ogDescription="Tu mini contador personal en Perú. Menos caos con tus boletas, más claridad con tus gastos."
>
	<a class="skip-link" href="#contenido">Saltar al contenido</a>
	<Header />
	<main id="contenido">
		<Hero />
		<HowItWorks />
		<Story />
		<Voice />
		<Features />
		<PersonalNote />
		<Faq />
		<FinalCta />
	</main>
	<Footer />
</BaseLayout>

<script>
	import "../scripts/marketing.ts";
</script>
