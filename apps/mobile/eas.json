{
	"cli": {
		"version": ">= 21.8.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"android": {
				"buildType": "apk",
				"gradleCommand": ":app:assembleDebug"
			}
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview",
			"environment": "preview"
		},
		"production": {
			"autoIncrement": true,
			"channel": "production",
			"environment": "production"
		}
	},
	"submit": {
		"production": {}
	}
}
