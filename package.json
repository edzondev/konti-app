{
	"name": "konti-app",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"check": "biome check . && turbo run typecheck",
		"check:write": "biome check --write .",
		"build:api": "turbo run build --filter=@repo/api",
		"start:api": "pnpm --filter=@repo/api run start:prod"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"turbo": "^2.11.2",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24"
	}
}
